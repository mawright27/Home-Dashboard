# Copy to .env and fill in, for running the sync locally:
#   set -a && source .env && set +a
#   node scripts/sync-calendar.mjs --dry-run
#
# .env is gitignored. These same names become GitHub repository secrets.

# ── Google OAuth ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=1090775992930-0nthvb1ue3t72latnvvis13cr3ne17qe.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ── Firebase ───────────────────────────────────────────────────
# Realtime Database URL, no trailing slash.
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# Your Google account's Firebase UID — the household the panels read.
# Find it in the dashboard: sign in, open a sensor tile, and the path
# shown is households/<this>/sensors/...
FIREBASE_HOUSEHOLD_ID=

# Pick ONE of the following two.
# Preferred: the whole service account JSON on a single line.
FIREBASE_SERVICE_ACCOUNT=
# Simpler: Project settings → Service accounts → Database secrets.
FIREBASE_DATABASE_SECRET=

# ── Optional ───────────────────────────────────────────────────
CALENDAR_IDS=primary
CALENDAR_TONES=cool
HOUSEHOLD_TZ=America/New_York
DAYS_BACK=7
DAYS_AHEAD=35
